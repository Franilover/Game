[gd_resource type="Resource" script_class="CutsceneSequence" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/cutscene_sequence.gd" id="1"]

[resource]
script = ExtResource("1")
clave = "intercambio_con_tercero_{{clave}}"
descripcion = "Tres personas que ya están en el lugar comparten un intercambio breve sin cambiar sus posiciones."
modo = "planeada"
pasos = Array[Dictionary]([{
"tipo": "camara",
"x": "{{x}}",
"y": "{{y}}",
"zoom": "{{zoom}}",
"duracion": "{{duracion_camara}}",
"margen_encuadre": 92.0
}, {
"tipo": "orientar_grupo",
"npcs": ["{{npc_a}}", "{{npc_b}}"],
"hacia_npc": "{{tercero}}"
}, {
"tipo": "orientar_grupo",
"npcs": ["{{tercero}}"],
"hacia_npc": "{{npc_a}}"
}, {
"tipo": "acciones_simultaneas",
"acciones": [{
"tipo": "gesto_npc",
"npc": "{{tercero}}",
"gesto": "saludar",
"duracion": 0.55
}, {
"tipo": "gesto_npc",
"npc": "{{npc_a}}",
"gesto": "sorpresa",
"duracion": 0.42
}, {
"tipo": "gesto_npc",
"npc": "{{npc_b}}",
"gesto": "asentir",
"duracion": 0.42
}]
}, {
"tipo": "esperar",
"segundos": 0.35,
"variacion": 0.12
}, {
"tipo": "acciones_simultaneas",
"acciones": [{
"tipo": "gesto_npc",
"npc": "{{npc_a}}",
"gesto": "{{gesto_a}}",
"duracion": "{{duracion_gesto}}"
}, {
"tipo": "gesto_npc",
"npc": "{{npc_b}}",
"gesto": "{{gesto_b}}",
"duracion": "{{duracion_gesto}}"
}, {
"tipo": "gesto_npc",
"npc": "{{tercero}}",
"gesto": "asentir",
"duracion": 0.5
}]
}, {
"tipo": "esperar",
"segundos": "{{pausa_despues}}",
"variacion": 0.15
}])
parametros_requeridos = PackedStringArray("clave", "x", "y", "npc_a", "npc_b", "tercero", "zoom", "duracion_camara", "pausa_despues", "gesto_a", "gesto_b", "duracion_gesto")
