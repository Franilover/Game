[gd_resource type="Resource" script_class="CutsceneSequence" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/gameplay/cutscene_sequence.gd" id="1"]

[resource]
script = ExtResource("1")
clave = "intercambio_con_tercero_{{clave}}"
descripcion = "Una tercera persona se acerca caminando, es recibida por quienes conversan, participa con reacciones breves y luego se retira."
modo = "en_vivo"
pasos = Array[Dictionary]([{
"tipo": "camara",
"x": "{{x}}",
"y": "{{y}}",
"seguir_npcs": ["{{npc_a}}", "{{npc_b}}"],
"zoom": "{{zoom}}",
"duracion": "{{duracion_camara}}"
}, {
"tipo": "esperar",
"segundos": "{{pausa_antes}}",
"variacion": 0.1
}, {
"tipo": "incorporar_npc",
"npc": "{{tercero}}",
"x": "{{tercero_llegada_x}}",
"y": "{{tercero_llegada_y}}",
"duracion": 1.1
}, {
"tipo": "camara",
"x": "{{x}}",
"y": "{{y}}",
"seguir_npcs": ["{{npc_a}}", "{{npc_b}}", "{{tercero}}"],
"zoom": "{{zoom}}",
"duracion": 0.55,
"margen_encuadre": 92.0
}, {
"tipo": "orientar_grupo",
"npcs": ["{{npc_a}}", "{{npc_b}}"],
"hacia_npc": "{{tercero}}"
}, {
"tipo": "acciones_simultaneas",
"acciones": [{
"tipo": "gesto_npc",
"npc": "{{tercero}}",
"gesto": "saludar",
"duracion": 0.55
}, {
"tipo": "gesto_npc",
"npc": "{{npc_a}}",
"gesto": "sorpresa",
"duracion": 0.42
}, {
"tipo": "gesto_npc",
"npc": "{{npc_b}}",
"gesto": "asentir",
"duracion": 0.42
}]
}, {
"tipo": "esperar",
"segundos": 0.35,
"variacion": 0.12
}, {
"tipo": "acciones_simultaneas",
"acciones": [{
"tipo": "gesto_npc",
"npc": "{{npc_a}}",
"gesto": "{{gesto_a}}",
"duracion": "{{duracion_gesto}}"
}, {
"tipo": "gesto_npc",
"npc": "{{npc_b}}",
"gesto": "{{gesto_b}}",
"duracion": "{{duracion_gesto}}"
}, {
"tipo": "gesto_npc",
"npc": "{{tercero}}",
"gesto": "asentir",
"duracion": 0.5
}]
}, {
"tipo": "esperar",
"segundos": "{{pausa_despues}}",
"variacion": 0.15
}, {
"tipo": "retirar_npc",
"npc": "{{tercero}}",
"x": "{{tercero_salida_x}}",
"y": "{{tercero_salida_y}}",
"duracion": 0.9
}, {
"tipo": "camara",
"x": "{{x}}",
"y": "{{y}}",
"seguir_npcs": ["{{npc_a}}", "{{npc_b}}"],
"zoom": "{{zoom}}",
"duracion": 0.45
}])
parametros_requeridos = PackedStringArray("clave", "x", "y", "npc_a", "npc_b", "tercero", "tercero_llegada_x", "tercero_llegada_y", "tercero_salida_x", "tercero_salida_y", "zoom", "duracion_camara", "pausa_antes", "pausa_despues", "gesto_a", "gesto_b", "duracion_gesto")
